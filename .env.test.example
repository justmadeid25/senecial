# Used by `pnpm test` (via dotenv-cli) to run integration tests against a
# database that is separate from the main development database, so tests
# never depend on (or corrupt) local dev data.
#
# docker-compose.yml creates this senecial_test database automatically
# alongside the main senecial database - see docker/init-test-db.sql.
DATABASE_URL="postgresql://senecial:development-only-password@localhost:5432/senecial_test?schema=public"
AUTH_SECRET=test-only-secret-not-for-production-use
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
FILE_STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20
INVITATION_MAILER=development
ALLOW_DEVELOPMENT_INVITATION_MAILER=false
FILE_MALWARE_SCANNER=noop
ALLOW_NOOP_MALWARE_SCANNER=false
CONTRACT_EXTRACTION_PROVIDER=development
ALLOW_DEVELOPMENT_EXTRACTION_PROVIDER=false
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_STALE_MINUTES=15
EXTRACTION_BATCH_SIZE=10
CLAUSE_SEGMENTATION_PROVIDER=development
ALLOW_DEVELOPMENT_CLAUSE_SEGMENTER=false
CLAUSE_SEGMENTATION_MAX_ATTEMPTS=3
CLAUSE_SEGMENTATION_STALE_MINUTES=15
CLAUSE_SEGMENTATION_BATCH_SIZE=10
ANALYTICS_DEFAULT_MONTHS=12
ANALYTICS_MAX_DATE_RANGE_MONTHS=60
ANALYTICS_CSV_MAX_ROWS=10000
RETENTION_SOFT_DELETED_CONTRACT_DAYS=30
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_INVITATION_DAYS=90
RETENTION_NOTIFICATION_DAYS=365
RETENTION_FAILED_JOB_DAYS=90
RETENTION_PURGE_BATCH_SIZE=100
BACKUP_ENCRYPTION_PROVIDER=noop
ALLOW_UNENCRYPTED_BACKUP=false
BACKUP_OUTPUT_DIR=./backups
BACKUP_CONFIRM=false
DISASTER_RECOVERY_DRILL_CONFIRM=false
RATE_LIMITER=memory
ALLOW_IN_MEMORY_RATE_LIMITER=false
ACCOUNT_SECURITY_MAILER=development
ALLOW_DEVELOPMENT_ACCOUNT_SECURITY_MAILER=false
EMAIL_VERIFICATION_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_HOURS=1
