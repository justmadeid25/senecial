# Senecial - Railway worker image (background batch job processing only).
#
# Companion to the root Dockerfile (the production Next.js web app, deployed
# to Vercel - NOT built from this file). This file exists because Railway
# rejects any Dockerfile containing a `VOLUME` directive ("dockerfile
# invalid: docker VOLUME ... is not supported, use Railway Volumes").
#
# The root Dockerfile's `VOLUME ["/app/storage"]` exists only to support
# FILE_STORAGE_DRIVER=local for a Docker-hosted deployment of the WEB APP
# (see its own comment above that line) - this worker never sets
# FILE_STORAGE_DRIVER=local (production file storage is Cloudflare R2 via
# FILE_STORAGE_DRIVER=s3 on both the Vercel web app and this worker) and has
# no other persistent-local-disk requirement: every scheduled batch script
# in docs/operations/batch-jobs.md only reads/writes Postgres, S3-compatible
# storage, or Redis - none of them touch the local filesystem for anything
# but transient OS-tmpdir scratch space (already writable by any user via
# the base image's default /tmp permissions, no volume needed). Editing the
# root Dockerfile to drop VOLUME instead would change its existing,
# documented, Docker-Compose-smoke-tested deployment contract (README /
# docs/operations/deployment.md's `docker run -v senecial_storage:/app/storage`
# example) for a case (FILE_STORAGE_DRIVER=local) this worker doesn't use
# but a real Docker-hosted deployment of the web app still legitimately
# might - so that file is intentionally left untouched.
#
# This worker never runs `next build`/`next start` - it only ever executes
# `scripts/*.ts` via `tsx` (see package.json's extraction:process/
# clauses:process/mail:process/etc. scripts), which import directly from
# `src/` and need the full source + devDependencies (tsx, prisma CLI), never
# compiled Next.js output - so unlike the root Dockerfile's `builder` stage,
# there is no `pnpm run build` / instrumentation-copy step here.
#
# `deps`/`builder` stage commands intentionally mirror the root Dockerfile's
# own `pnpm install --frozen-lockfile` + `pnpm exec prisma generate` - keep
# the two in sync if either changes.
#
# CMD below is a PLACEHOLDER pending the worker scheduling design (which
# batch scripts run on which cadence, and via what mechanism - Railway cron
# vs. an in-container scheduler) - not yet decided. Replace before this
# image is actually used to process anything.

FROM node:22-bookworm-slim AS base
RUN corepack enable

# ---------------------------------------------------------------------------
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# DATABASE_URL is not required for `prisma generate` (it only reads
# prisma/schema.prisma) - no real secret is ever baked into this image,
# matching the root Dockerfile's own `builder` stage comment.
RUN pnpm exec prisma generate

# ---------------------------------------------------------------------------
FROM base AS worker
WORKDIR /app

# Build identity, same rationale as the root Dockerfile's `runner` stage -
# baked in at build time via --build-arg, never a secret.
ARG GIT_COMMIT_SHA=unknown
ARG BUILD_DATE=unknown
ENV GIT_COMMIT_SHA=${GIT_COMMIT_SHA}
ENV BUILD_DATE=${BUILD_DATE}
ENV NODE_ENV=production

COPY --from=builder --chown=node:node /app /app

USER node

CMD ["node", "-e", "console.log('senecial worker placeholder image - scheduling not yet configured, see Dockerfile.worker'); setInterval(() => {}, 1 << 30);"]
