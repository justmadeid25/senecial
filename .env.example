# PostgreSQL connection string used by Prisma.
# Matches docker-compose.yml (pnpm db:up). The password below is a
# development-only default - never reuse it anywhere else.
DATABASE_URL="postgresql://senecial:development-only-password@localhost:5432/senecial?schema=public"

# Auth.js (Auth.js v5 / next-auth@beta) session/token signing secret.
# Generate one with: npx auth secret
# Required in production - NextAuth.js throws if unset outside development.
AUTH_SECRET=

# Canonical app URL. Auth.js can usually infer this from request headers,
# but setting it explicitly avoids surprises behind proxies.
AUTH_URL=http://localhost:3000

APP_URL=http://localhost:3000

# File storage driver: "local" (default) or "s3" (any S3-compatible
# provider - AWS S3, Cloudflare R2, MinIO, ...) - see src/server/storage.
FILE_STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20

# ---------------------------------------------------------------------------
# Phase 10A - S3-compatible storage. Only required when FILE_STORAGE_DRIVER=s3
# (or when running scripts/storage-migrate-to-s3.ts). Access key/secret may be
# left unset to use the AWS SDK's default credential provider chain (IAM
# role / workload identity / ECS task role / ...) instead. Presigned URLs are
# NOT used in this phase - downloads always go through the app's own
# authenticated route, never a direct-to-client S3 link.
# ---------------------------------------------------------------------------
# S3_ENDPOINT=              # unset = real AWS S3's own default endpoint; set for R2/MinIO/other S3-compatible providers
S3_REGION=us-east-1
S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false   # true for most self-hosted S3-compatible providers (e.g. MinIO)
# S3_SERVER_SIDE_ENCRYPTION=AES256   # or "aws:kms" - see README for provider-support caveats (e.g. default MinIO rejects this)
# S3_KMS_KEY_ID=             # only when S3_SERVER_SIDE_ENCRYPTION=aws:kms
S3_UPLOAD_CHECKSUM=true

# Invitation email delivery. "development" sends no real email (logs the
# link to the console and returns it directly to the inviting OWNER in the
# UI) - see src/server/services/invitations. Refused outside development
# unless ALLOW_DEVELOPMENT_INVITATION_MAILER=true is also set. Phase 10B
# adds "real" - sends via whichever provider EMAIL_PROVIDER selects below.
# Needs no override flag - it IS the real production driver.
INVITATION_MAILER=development
ALLOW_DEVELOPMENT_INVITATION_MAILER=false

# Malware scanning for uploaded contract files. "noop" performs NO actual
# scanning - see src/server/services/contract-files. Refused outside
# development unless ALLOW_NOOP_MALWARE_SCANNER=true is also set.
FILE_MALWARE_SCANNER=noop
ALLOW_NOOP_MALWARE_SCANNER=false

# Contract field extraction provider. "development" is a regex/rule-based
# extractor (DeterministicDevelopmentContractExtractor) - NOT a real AI
# model - see src/server/services/extraction. Refused outside development
# unless ALLOW_DEVELOPMENT_EXTRACTION_PROVIDER=true is also set. No real
# provider is implemented in this phase; a real integration would add its
# own driver value here.
CONTRACT_EXTRACTION_PROVIDER=development
ALLOW_DEVELOPMENT_EXTRACTION_PROVIDER=false

# How many times a failed extraction job may be retried before it is
# treated as permanently failed.
EXTRACTION_MAX_ATTEMPTS=3

# A PROCESSING extraction job whose lock is older than this is presumed to
# have lost its worker - see scripts/recover-stale-extraction-jobs.ts.
EXTRACTION_STALE_MINUTES=15

# Max number of jobs scripts/process-extraction-jobs.ts claims and
# processes per invocation when neither --once nor --limit is passed.
EXTRACTION_BATCH_SIZE=50

# Clause segmentation/classification provider. "development" is a
# regex/rule-based segmenter+classifier (DeterministicKoreanClauseSegmenter
# / DeterministicKoreanClauseClassifier) - NOT a real AI model - see
# src/server/services/clauses. Refused outside development unless
# ALLOW_DEVELOPMENT_CLAUSE_SEGMENTER=true is also set. No real provider is
# implemented in this phase; a real integration would add its own driver
# value here.
CLAUSE_SEGMENTATION_PROVIDER=development
ALLOW_DEVELOPMENT_CLAUSE_SEGMENTER=false

# How many times a failed clause segmentation job may be retried before it
# is treated as permanently failed.
CLAUSE_SEGMENTATION_MAX_ATTEMPTS=3

# A PROCESSING clause segmentation job whose lock is older than this is
# presumed to have lost its worker - see scripts/recover-stale-clause-jobs.ts.
CLAUSE_SEGMENTATION_STALE_MINUTES=15

# Max number of jobs scripts/process-clause-segmentation-jobs.ts claims and
# processes per invocation when neither --once nor --limit is passed.
CLAUSE_SEGMENTATION_BATCH_SIZE=10

# Default period length (months) applied to analytics screens when no
# explicit date range filter is given.
ANALYTICS_DEFAULT_MONTHS=12

# Widest date range (months) an analytics period filter may span - wider
# requests are silently clamped, never rejected.
ANALYTICS_MAX_DATE_RANGE_MONTHS=60

# Hard cap on the number of rows a single CSV export may contain.
ANALYTICS_CSV_MAX_ROWS=10000

# ---------------------------------------------------------------------------
# Phase 9 - data retention (days). See README's data classification table
# for exactly which timestamp each one is measured from.
# ---------------------------------------------------------------------------
RETENTION_SOFT_DELETED_CONTRACT_DAYS=30
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_INVITATION_DAYS=90
RETENTION_NOTIFICATION_DAYS=365
RETENTION_FAILED_JOB_DAYS=90
RETENTION_PURGE_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Phase 9 - backup/restore. "noop" performs NO real encryption - see
# src/server/backup. Refused in production unless ALLOW_UNENCRYPTED_BACKUP
# is also set (deprecated - development/emergency-diagnostic use only).
#
# Phase 10C adds "age" - real streaming envelope encryption via the `age`
# format (age-encryption npm package, X25519 + ChaCha20-Poly1305 STREAM).
# Needs no override flag - it IS a real production driver. BACKUP_AGE_RECIPIENTS
# (comma-separated age1... public keys) is required to encrypt. BACKUP_AGE_IDENTITY
# (AGE-SECRET-KEY-1... private key) is only required to DECRYPT (restore/DR
# drill) - keep it off the routine backup host; it only belongs on the
# operator machine performing a restore. Generate a keypair once with:
#   node -e "require('age-encryption').generateIdentity().then(async k=>{console.log('identity:',k);console.log('recipient:',await require('age-encryption').identityToRecipient(k))})"
# BACKUP_AGE_KEY_ID is an optional operator-chosen label (never the key
# itself) recorded in the manifest to identify which key was used.
# ---------------------------------------------------------------------------
BACKUP_ENCRYPTION_PROVIDER=noop
ALLOW_UNENCRYPTED_BACKUP=false
# BACKUP_AGE_RECIPIENTS=age1...
# BACKUP_AGE_IDENTITY=AGE-SECRET-KEY-1...
# BACKUP_AGE_KEY_ID=
BACKUP_OUTPUT_DIR=./backups
# Only needed if pg_dump/pg_restore are not on PATH under their default names.
# PG_DUMP_BIN=pg_dump
# PG_RESTORE_BIN=pg_restore
# TAR_BIN=tar
BACKUP_CONFIRM=false
DISASTER_RECOVERY_DRILL_CONFIRM=false

# ---------------------------------------------------------------------------
# Phase 9 - rate limiting. "memory" is process-local only (does not
# coordinate across multiple app instances) - see src/server/services/rate-limit.
# Refused in production unless ALLOW_IN_MEMORY_RATE_LIMITER is also set.
# Phase 10A adds "redis" - coordinates across every app instance sharing the
# same Redis, via an atomic Lua script (never separate GET/INCR/EXPIRE
# calls). Needs no override flag - it IS the real production driver.
# Per-purpose overrides: RATE_LIMIT_<PURPOSE>_MAX / _WINDOW_SECONDS (see
# src/lib/config/rate-limit.ts for the full list and defaults).
# ---------------------------------------------------------------------------
RATE_LIMITER=memory
ALLOW_IN_MEMORY_RATE_LIMITER=false

# ---------------------------------------------------------------------------
# Phase 10A - Redis (only required when RATE_LIMITER=redis). Standard Redis
# connection string, e.g. redis://[:password@]host:port[/db] or
# rediss://... for TLS. REDIS_KEY_PREFIX namespaces every key this app
# writes, in case the same Redis instance is shared with other apps.
# RATE_LIMIT_FAIL_MODE=closed (default) means a Redis outage BLOCKS every
# rate-limited request (login, signup, password reset, invitations, file
# upload, CSV export, member role changes) rather than letting it through -
# every one of these is a sensitive/write endpoint, so failing open is not
# offered as a real option in this codebase; set to "open" only as an
# explicit, audited exception.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=senecial
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=2000
RATE_LIMIT_FAIL_MODE=closed

# ---------------------------------------------------------------------------
# Phase 10A - reverse-proxy IP trust (used for rate-limit IP-prefix
# bucketing only - never for authorization). TRUST_PROXY defaults to false
# (safe default): X-Forwarded-For/X-Real-IP are fully client-spoofable
# without a trusted proxy actually overwriting them, so they are ignored
# entirely unless explicitly enabled. TRUSTED_PROXY_HOPS (default 1) is how
# many reverse proxies you control sit in front of this app - set it to
# match your actual deployment topology (e.g. 1 for a single nginx/load
# balancer hop, 2 if there's also a CDN in front of that).
# ---------------------------------------------------------------------------
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Phase 9 - account security (email verification / password reset).
# "development" sends no real email (logs the link to the console) - see
# src/server/services/account-security. Refused outside development unless
# ALLOW_DEVELOPMENT_ACCOUNT_SECURITY_MAILER=true is also set. Phase 10B
# adds "real" - see EMAIL_* below.
# ---------------------------------------------------------------------------
ACCOUNT_SECURITY_MAILER=development
ALLOW_DEVELOPMENT_ACCOUNT_SECURITY_MAILER=false
EMAIL_VERIFICATION_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_HOURS=1

# ---------------------------------------------------------------------------
# Phase 10B - transactional email. Only required when INVITATION_MAILER=real
# or ACCOUNT_SECURITY_MAILER=real. EMAIL_PROVIDER selects the low-level
# transport - only "postmark" is actually implemented in this Phase
# (ses/resend/sendgrid are named extension points only - see
# src/server/services/email). EMAIL_FROM_ADDRESS is required; EMAIL_REPLY_TO
# and EMAIL_SUPPORT_ADDRESS are optional. Neither the from-name nor any
# address may contain CR/LF (header-injection prevention - see
# domain/email/email-address.ts).
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=postmark
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Senecial
EMAIL_REPLY_TO=
EMAIL_SUPPORT_ADDRESS=
# POSTMARK_SERVER_TOKEN=            # required when EMAIL_PROVIDER=postmark
POSTMARK_MESSAGE_STREAM=outbound

# ---------------------------------------------------------------------------
# Phase 11 - /api/metrics (Prometheus text format). Unset (the default)
# means the endpoint always returns 404 - metrics are never exposed unless
# explicitly opted into. When set, a request must send
# `Authorization: Bearer <METRICS_TOKEN>` matching this value exactly, or
# it also gets a plain 404 (never 401/403 - never reveals the endpoint
# exists to an unauthenticated prober). Still put this behind a reverse
# proxy that blocks external traffic to this path entirely in production -
# see docs/operations/monitoring.md.
# ---------------------------------------------------------------------------
# METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Phase 12 - AI Contract Intelligence Platform. AI_EMBEDDING_PROVIDER /
# AI_LLM_PROVIDER default to "development" (a real, deterministic, non-AI
# fallback - hashing-trick embedding / extractive-summary completion, NOT
# a real model) and are blocked in production unless
# ALLOW_DEVELOPMENT_AI_PROVIDER=true is explicitly set. Real provider
# values: openai | azure-openai | anthropic | gemini | ollama (each needs
# its own API key/endpoint env vars - see src/server/services/ai/providers).
# ---------------------------------------------------------------------------
AI_EMBEDDING_PROVIDER=development
AI_LLM_PROVIDER=development
# ALLOW_DEVELOPMENT_AI_PROVIDER=true
# AI_MIN_CITATION_SCORE=0.15        # Hallucination Guard threshold - see domain/ai/hallucination-guard.ts
# AI_MIN_CITATION_COUNT=1

# ---------------------------------------------------------------------------
# Phase 12.1 - DB-native vector search (pgvector). Reversed polarity from
# every other AI provider above: "pgvector" (the real, DB-native path) is
# the recommended DEFAULT here, with "application" (in-process cosine
# fallback) as the explicit opt-out - see docs/operations/ai-platform.md.
# AI_VECTOR_SEARCH_ALLOW_FALLBACK=true only applies when the provider is
# pgvector AND a query actually fails - it is never a silent per-request
# degrade otherwise.
# ---------------------------------------------------------------------------
AI_VECTOR_SEARCH_PROVIDER=pgvector
# AI_VECTOR_SEARCH_ALLOW_FALLBACK=true

# ---------------------------------------------------------------------------
# Phase 12 Part N / 12.1 Part 15 - embedding/retrieval/prompt caches.
# AI_CACHE_PROVIDER defaults to "memory" (process-local) and is blocked in
# production unless ALLOW_IN_MEMORY_AI_CACHE=true; "redis" reuses the same
# REDIS_URL/REDIS_KEY_PREFIX config as RATE_LIMITER=redis, under its own
# key namespace.
# ---------------------------------------------------------------------------
AI_CACHE_PROVIDER=memory
# ALLOW_IN_MEMORY_AI_CACHE=true
# AI_EMBEDDING_CACHE_TTL_SECONDS=86400
# AI_RETRIEVAL_CACHE_TTL_SECONDS=300
# AI_PROMPT_CACHE_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Phase 12.2 Part E (§33) - AI concurrency limit (in-flight requests, not a
# throughput window - see RATE_LIMIT_AI_ASK_MAX/_WINDOW_SECONDS above for
# that). Reuses RATE_LIMITER (memory|redis) and ALLOW_IN_MEMORY_RATE_LIMITER
# above - not a separate driver knob.
# ---------------------------------------------------------------------------
# AI_CONCURRENCY_MAX_PER_USER=3
# AI_CONCURRENCY_MAX_PER_ORGANIZATION=10
# AI_CONCURRENCY_LEASE_SECONDS=120
