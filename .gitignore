# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
/.test-scratch

# Phase 10B - development-mailer test mailbox (E2E link retrieval only, never real email)
/.test-mailbox

# backup output (never commit real or test backup archives/dumps)
/backups

# Phase 10C - project-local dev/test PostgreSQL 18.4 instance (port 5433,
# started manually via pg_ctl - see docs/operations/backup.md). Never commit
# database files or the dev-only password file.
/.devdb

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.example
!.env.e2e.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local file storage (uploaded contract files must never be committed)
/storage/*
!/storage/.gitkeep

# local dev-only MinIO data directory (Phase 10A real S3-compatible test infra)
/.minio-data

# Phase 12 - AI evaluation CLI (`pnpm ai:evaluate`) output - regenerated
# each run, never a committed artifact. Phase 13 §45 / Phase 13.1 §14
# exception: ai-cost-baseline.json and ai-production-quality-baseline.json
# ARE committed (needed across CI runs by scripts/ai-cost-regression-check.ts
# and as the recorded production baseline) - the /reports/* + negation form
# (rather than a bare /reports directory-ignore) is required for git to
# actually re-include specific files inside an otherwise-ignored directory.
/reports/*
!/reports/ai-cost-baseline.json
!/reports/ai-production-quality-baseline.json

# Phase 12.2 - per-run E2E storage isolation (tmp/e2e-storage/<run-id>) and
# any other scratch output - regenerated per run, never committed.
/tmp

# Phase 13.2 - auto-generated local agent-instruction artifacts, written
# and re-added by `next dev` (node_modules/next/dist/server/lib/
# generate-agent-files.js) - not application source, not required for
# TypeScript/build/tests/runtime. Treated as reproducible local output
# rather than a committed project artifact.
/AGENTS.md
/CLAUDE.md
