# Phase 12.2 Part B (§9) - dedicated E2E database, separate from both the
# dev DB (.env) and the Vitest integration-test DB (.env.test's
# clausebase_test) - Playwright and Vitest no longer share a database.
# tests/e2e/global-setup.ts creates this database if missing, runs
# migrations, and deterministically truncates every app table before each
# full E2E run - never share this DB with development or benchmark data.
DATABASE_URL="postgresql://clausebase:development-only-password@127.0.0.1:5433/clausebase_e2e?schema=public"
AUTH_SECRET=e2e-only-secret-not-for-production-use-0000000000
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
FILE_STORAGE_DRIVER=local
# Overridden per-run by playwright.config.ts to tmp/e2e-storage/<run-id> -
# this value is only the fallback for anything that reads it before that
# override applies.
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20
